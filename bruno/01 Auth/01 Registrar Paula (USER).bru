meta {
  name: Registrar Paula (USER)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "paula@huellitas.com",
    "password": "paula123"
  }
}

assert {
  res.status: eq 200
  res.body.token: isString
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("tokenUser", res.body.token);
    bru.setEnvVar("token", res.body.token);
  }
}

docs {
  Matriz #2: registro válido -> 200 y token. El rol siempre queda USER.
  Si Paula ya existe, usa "Login Paula".
}
