meta {
  name: Registro invalido
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "correo-invalido",
    "password": "123"
  }
}

assert {
  res.status: eq 400
}

docs {
  Matriz #3: email inválido y clave corta -> 400 con errores por campo.
}
