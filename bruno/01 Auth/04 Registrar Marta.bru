meta {
  name: Registrar Marta
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "marta@huellitas.com",
    "password": "marta123"
  }
}

assert {
  res.status: eq 200
}

docs {
  Se registra como USER. Después, en la base de datos:

  UPDATE usuarios SET rol = 'ADMIN' WHERE email = 'marta@huellitas.com';

  y luego ejecuta "Login Marta (ADMIN)".
}
