meta {
  name: Crear veterinario con ADMIN (201)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/veterinarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombre": "Andrés Gómez",
    "especialidad": "Medicina general"
  }
}

assert {
  res.status: eq 201
  res.body.id: isNumber
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("veterinarioId", res.body.id);
  }
}

docs {
  Matriz #7: POST /api/veterinarios con ADMIN -> 201 y veterinario persistido.
}
