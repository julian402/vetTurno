meta {
  name: Crear propietario
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/propietarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "Carlos Pérez",
    "telefono": "3001234567",
    "email": "carlos@mail.com"
  }
}

assert {
  res.status: eq 201
  res.body.id: isNumber
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("propietarioId", res.body.id);
  }
}

docs {
  Matriz #8: creación válida -> 201 y DTO sin colecciones anidadas.
}
